{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go doc *)",
      "Bash(go list *)",
      "Bash(go mod tidy)",
      "Bash(go mod download)",
      "Bash(gofmt -l *)",
      "Bash(golangci-lint run *)",
      "Bash(make build)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make run)",
      "Bash(make dev-up)",
      "Bash(make dev-down)",
      "Bash(openspec list *)",
      "Bash(openspec validate *)",
      "Bash(openspec show *)",
      "Bash(openspec status *)",
      "Bash(scripts/publish_guard.sh *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(docker compose -f dev/docker-compose.yml ps *)",
      "Bash(docker compose -f dev/docker-compose.yml logs *)",
      "Bash(curl -s http://localhost:59880/*)",
      "Bash(curl -s http://localhost:59881/*)",
      "Bash(curl -s http://localhost:59882/*)",
      "Bash(curl -s http://localhost:59900/*)",
      "WebFetch(domain:docs.edgexfoundry.org)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:pkg.go.dev)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(**/*secret*)",
      "Read(.claude/publish-guard.local.txt)"
    ]
  }
}
